[Unit]
Description=Noha dashboard and captive Wi-Fi setup on port 80
Wants=noha-network.service noha-admin.service
After=noha-network.service noha-admin.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=noha-portal
Group=noha-portal
ExecStart=/opt/noha/current/venv/bin/noha web
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
UMask=0077

[Install]
WantedBy=multi-user.target

